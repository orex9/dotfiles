{
  "id": "root",
  "type": "row",
  "titlebar": "none",
  "traffic_lights": [12, 16],
  "theme": "pixel",
  "font": "GohuFont uni14 Nerd Font",
  "ui_font": "GohuFont uni14 Nerd Font",
  "font_size": 14,
  "background": "canvas",
  "terminal_padding": [12, 10],
  "padding": 8,
  "gap": 8,
  "preview": "layouts/pixel.svg",
  "toast": "pixel-toast",
  "terminal_menu": "pixel-menu",
  "children": [
    {
      "id": "sidebar",
      "type": "column",
      "size": { "px": 268 },
      "min": 44,
      "max": 480,
      "background": "chrome",
      "border": { "width": 2, "color": "border" },
      "children": [
        {
          "id": "brand",
          "type": "block",
          "size": { "px": 46 },
          "window_drag": true,
          "content": { "mod": "pixel-workspace-chrome" }
        },
        {
          "id": "sidebar-lists",
          "type": "column",
          "divider": { "width": 1, "color": "border" },
          "children": [
            {
              "id": "spaces",
              "type": "block",
              "size": { "weight": 1 },
              "min": 90,
              "content": { "mod": "pixel-spaces" }
            },
            {
              "id": "agents",
              "type": "block",
              "size": { "weight": 1 },
              "min": 90,
              "content": { "mod": "pixel-agents" }
            }
          ]
        },
        {
          "id": "sidebar-footer",
          "type": "block",
          "size": { "px": 69 },
          "content": { "mod": "pixel-workspace-chrome", "props": { "footer": true } }
        }
      ]
    },
    {
      "id": "work",
      "type": "column",
      "gap": 8,
      "children": [
        {
          "id": "tabs",
          "type": "block",
          "size": { "px": 42 },
          "window_drag": true,
          "content": { "mod": "pixel-tabs" }
        },
        {
          "id": "work-body",
          "type": "row",
          "gap": 8,
          "children": [
            {
              "id": "main",
              "type": "block",
              "content": {
                "tab": "active",
                "pane": {
                  "gap": 8,
                  "radius": 0,
                  "background": "background",
                  "lone": true,
                  "border": { "width": 2, "color": "border" },
                  "focus": { "width": 2, "color": "accent" },
                  "header": {
                    "content": { "mod": "pixel-pane" },
                    "height": 30,
                    "position": "top",
                    "reveal": "always"
                  }
                }
              }
            },
            {
              "id": "panel",
              "type": "column",
              "hidden": true,
              "size": { "px": 368 },
              "min": 280,
              "max": 900,
              "children": [
                {
                  "id": "panel-body",
                  "type": "stack",
                  "active": "files",
                  "children": [
                    {
                      "id": "files",
                      "type": "block",
                      "content": { "mod": "pixel-files" }
                    },
                    {
                      "id": "changes",
                      "type": "block",
                      "content": { "mod": "pixel-changes" }
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "id": "status",
          "type": "block",
          "size": { "px": 28 },
          "content": { "mod": "pixel-workspace-status" }
        }
      ]
    }
  ]
}
